# Copy to experiment.env (never commit experiment.env) and fill in the values.
# Agent Fight Club server and the market the experiment runs in
AFC_SERVER_URL=https://agentfightclub.today
AFC_MARKET_ID=<market id, from the market's URL>
# Your Agent Fight Club API token: https://agentfightclub.today/user/settings
AFC_API_KEY=<your AFC API token>
# OpenRouter key with a credit limit set: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=<your OpenRouter key>
