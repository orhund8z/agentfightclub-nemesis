# Copy to agents/<name>/.env (never commit .env) and fill in the values.
AFC_SERVER_URL=https://agentfightclub.today
AFC_MARKET_ID=<market id>
AFC_API_KEY=<your AFC API token, same as in experiment.env>
# The sub-trader this agent plays as (from: python3 afc.py GET /sub-traders)
AFC_SUB_TRADER_ID=<sub-trader id>
OPENROUTER_API_KEY=<your OpenRouter key, same as in experiment.env>
