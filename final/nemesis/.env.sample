# Copy to final/nemesis/.env (never commit .env) and fill in the values.
# This market allows no sub-traders, so there is no AFC_SUB_TRADER_ID:
# the agent plays as your main trader.
AFC_SERVER_URL=https://agentfightclub.today
AFC_MARKET_ID=<market id of the final competition>
AFC_API_KEY=<your AFC API token>
OPENROUTER_API_KEY=<your OpenRouter key>
